# Runs the setup helper (scripts/setup/codemender_setup) with python3 3.9+.
# Usage: scripts/setup/codemender-setup <command> [options]; see --help.

set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
python=${CODEMENDER_SETUP_PYTHON:-python3}

if ! command -v "$python" >/dev/null 2>&1; then
  echo "codemender-setup: python3 not found; install Python 3.9 or later." >&2
  exit 2
fi
if ! "$python" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)'; then
  echo "codemender-setup: $("$python" -V 2>&1) is too old; Python 3.9 or later is needed." >&2
  exit 2
fi

PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec "$python" -m codemender_setup "$@"
